---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Not Found">
  <div class="flex h-screen w-full items-center justify-center bg-zinc-950">
    <div class="text-center space-y-4">
      <h1 class="text-6xl font-bold text-zinc-50">404</h1>
      <p class="text-xl text-zinc-400">Page not found</p>
      <a href="/" class="inline-block mt-4 rounded-lg bg-zinc-50 px-6 py-3 font-medium text-zinc-950 hover:bg-zinc-200 transition-colors">
        Go Home
      </a>
    </div>
  </div>
</Layout>
